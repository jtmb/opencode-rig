{
  "name": "opencode-rig-chatgpt-connector-v2-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode v2 ChatGPT OAuth server plugin and MCP connector.",
  "exports": {
    "./server": "./server.ts"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "test": "bash ../../scripts/run-bounded-command.sh -- node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "bash ../../scripts/run-bounded-command.sh --memory-fraction 55 --node-heap-fraction 80 -- ../node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opencode/client": "2.0.7",
    "@opencode/plugin": "2.0.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  }
}
