{
  "name": "opencode-rig-ponytail-adapter-v2-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode v2 adapter for the official Ponytail package.",
  "exports": {
    "./server": "./src/index.ts"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "test": "bash ../../scripts/run-bounded-command.sh -- node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "bash ../../scripts/run-bounded-command.sh -- ../node_modules/.bin/tsc --noEmit",
    "verify:package": "bash ../../scripts/run-bounded-command.sh -- node --experimental-strip-types scripts/verify-package.mjs",
    "verify:runtime": "bash ../../scripts/run-bounded-command.sh --timeout 10m -- node scripts/verify-runtime.mjs"
  },
  "dependencies": {
    "@dietrichgebert/ponytail": "4.10.0",
    "@opencode/plugin": "2.0.7"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  }
}
