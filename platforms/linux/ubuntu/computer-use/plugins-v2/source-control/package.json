{
  "name": "opencode-source-control-v2-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode v2 CLI plugin: working-tree and pull-request sidebar panel.",
  "exports": {
    "./tui": "./src/tui.tsx"
  },
  "scripts": {
    "check": "npm run typecheck && npm test",
    "test": "bash ../../scripts/run-bounded-command.sh -- node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "bash ../../scripts/run-bounded-command.sh -- ../node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "@opencode/plugin": "2.0.7"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  }
}
