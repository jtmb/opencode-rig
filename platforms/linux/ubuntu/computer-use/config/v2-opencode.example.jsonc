// OpenCode v2 (2.0.x) server/project example. Copy the relevant parts to
// <repo>/opencode.json or ~/.config/opencode/opencode.jsonc. v1 and v2 cannot
// share one config directory; this shape is v2-only.
//
// Differences from the v1 example:
// - `plugin` (tuple form) becomes `plugins` (object form).
// - MCP uses the v2 flat `mcp` map; a numeric `timeout` drops the whole block,
//   so either omit it or use the object form `{ "startup": 30000 }`.
// - Exactly ONE Playwright MCP is registered. Headless-only work runs through
//   the repository Playwright runtime from the shell instead of a second MCP.
// - v2 agents are the `agents` map; per-agent codex-fallback overrides move
//   under the plugin options `agents` key.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-flash",
  "provider": {
    "deepseek": {
      "options": { "apiKey": "{env:DEEPSEEK_API_KEY}" }
    }
  },
  "mcp": {
    "github": {
      "type": "local",
      "command": ["/home/james/repos/opencode-rig/platforms/linux/ubuntu/computer-use/scripts/github-mcp.sh"]
    },
    "playwright": {
      "type": "local",
      "command": ["/home/james/repos/opencode-rig/platforms/linux/ubuntu/computer-use/scripts/playwright-mcp.sh"]
    }
  },
  "plugins": [
    { "package": "/home/james/repos/opencode-rig/platforms/linux/ubuntu/computer-use/plugins-v2/rig-tools", "options": {} },
    { "package": "/home/james/repos/opencode-rig/platforms/linux/ubuntu/computer-use/plugins-v2/rig-todo", "options": {} },
    {
      "package": "/home/james/repos/opencode-rig/platforms/linux/ubuntu/computer-use/plugins-v2/codex-fallback",
      "options": {
        "defaultChain": [
          "deepseek/deepseek-v4-flash",
          "deepseek/deepseek-v4-pro",
          "opencode/muse-spark-1.3-contributor-free"
        ],
        "proactive": true,
        "triggerOn": "quota",
        "failureCooldownSeconds": 300,
        "sourceCooldownSeconds": 10800,
        "agents": {
          "build": { "mode": "chain", "proactive": true, "triggerOn": "any-retryable" },
          "plan": { "mode": "off" }
        }
      }
    }
  ]
}
