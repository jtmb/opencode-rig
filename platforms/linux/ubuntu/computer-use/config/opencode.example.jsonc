// Complete project-level example for <repo>/opencode.json.
// OpenCode also loads <repo>/.env automatically. The example references
// secrets with {env:NAME}; it never contains secret values.
//
// This file demonstrates the server plugin in project scope. The same plugin
// tuple may be moved to ~/.config/opencode/opencode.jsonc for global scope,
// but it must not be registered in both places. The TUI plugin is separate:
// see ~/.config/opencode/tui.json and the codex-usage documentation.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.3-codex-spark",
  "provider": {
    "deepseek": {
      "options": {
        "apiKey": "{env:DEEPSEEK_API_KEY}"
      }
    }
  },
  "plugin": [
    [
      "file:///home/james/repos/opencode-rig/platforms/linux/ubuntu/computer-use/plugins/codex-fallback/src/index.ts",
      {
        "defaultChain": [
          "deepseek/deepseek-v4-flash",
          "deepseek/deepseek-v4-pro",
          "opencode/muse-spark-1.3-contributor-free"
        ],
        "proactive": true,
        "notify": true,
        "triggerOn": "quota",
        "failureCooldownSeconds": 300,
        "sourceCooldownSeconds": 10800,
        "usageEndpoint": "https://chatgpt.com/backend-api/wham/usage",
        "usageCacheMs": 60000,
        "usageTimeoutMs": 5000,
        "debug": false
      }
    ]
  ],
  "agent": {
    "build": {
      "codexFallback": {
        "mode": "chain",
        "chain": [
          "deepseek/deepseek-v4-flash",
          "opencode/muse-spark-1.3-contributor-free"
        ],
        "proactive": true,
        "triggerOn": "any-retryable",
        "failureCooldownSeconds": 300,
        "sourceCooldownSeconds": 10800
      }
    },
    "plan": {
      "codexFallback": { "mode": "off" }
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["/home/james/repos/opencode-rig/platforms/linux/ubuntu/computer-use/scripts/playwright-mcp.sh"],
      "enabled": true,
      "timeout": 30000
    },
    "playwright_headless": {
      "type": "local",
      "command": ["/home/james/repos/opencode-rig/platforms/linux/ubuntu/computer-use/scripts/playwright-headless-mcp.sh"],
      "enabled": true,
      "timeout": 30000
    }
  }
}
