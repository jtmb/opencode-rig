# Copy this file to the project root as .env for local use.
# OpenCode loads a project .env automatically. Keep the real file untracked.
# Reference values from opencode.json with {env:VARIABLE_NAME}.

# Used by the example DeepSeek fallback provider.
DEEPSEEK_API_KEY=

# OpenAI/Codex OAuth is intentionally not stored here. Use:
#   opencode auth login
# The codex-usage and codex-fallback plugins read the managed auth.json entry.
