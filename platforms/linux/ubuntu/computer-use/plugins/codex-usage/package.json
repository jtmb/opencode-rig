{
  "name": "opencode-codex-usage-local",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OpenCode TUI sidebar for ChatGPT Codex weekly and optional Luna Reserve usage.",
  "scripts": {
    "check": "npm run typecheck && npm test",
    "check:usage": "bash ../../scripts/run-bounded-command.sh -- node --experimental-strip-types scripts/check-usage.ts",
    "test": "bash ../../scripts/run-bounded-command.sh -- node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "bash ../../scripts/run-bounded-command.sh -- node_modules/.bin/tsc --noEmit"
  },
  "dependencies": {
    "@opencode-ai/plugin": "1.18.31",
    "@opentui/core": "0.5.11",
    "@opentui/keymap": "0.5.11",
    "@opentui/solid": "0.5.11",
    "solid-js": "1.9.12"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "typescript": "5.9.3"
  }
}
