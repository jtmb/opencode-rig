{
  "version": 1,
  "rules": [
    {
      "name": "wsl2-ubuntu-computer-use",
      "match": [
        "platforms/windows/wsl2/ubuntu/computer-use/**",
        ".github/workflows/verify-wsl2.yml"
      ],
      "docs": [
        "platforms/windows/wsl2/ubuntu/computer-use/README.md",
        "docs/wsl2-acceptance-2026-09-21.md",
        "README.md"
      ],
      "onAdd": [
        "docs/README.md"
      ]
    },
    {
      "name": "setup-opencode",
      "match": [
        "platforms/linux/ubuntu/computer-use/scripts/setup-opencode.sh",
        "platforms/linux/ubuntu/computer-use/scripts/setup-opencode-jsonc.py",
        "platforms/linux/ubuntu/computer-use/scripts/setup-opencode-self-test.py"
      ],
      "docs": [
        "docs/scripts/setup-opencode.md"
      ]
    },
    {
      "name": "git-safety-gates",
      "match": [
        "platforms/linux/ubuntu/computer-use/scripts/check-git-safety-policy.py",
        "platforms/linux/ubuntu/computer-use/scripts/check-git-safety-policy-self-test.py"
      ],
      "docs": [
        "docs/scripts/git-safety-gates.md"
      ],
      "onAdd": [
        "docs/scripts/README.md"
      ]
    },
    {
      "name": "progress-tracking",
      "match": [
        "platforms/linux/ubuntu/computer-use/scripts/check-progress-tracking.py",
        "platforms/linux/ubuntu/computer-use/scripts/check-progress-tracking-self-test.py"
      ],
      "docs": [
        "docs/scripts/check-progress-tracking.md"
      ]
    },
    {
      "name": "plugin-resource-guards",
      "match": [
        "platforms/linux/ubuntu/computer-use/scripts/check-plugin-resource-guards.py",
        "platforms/linux/ubuntu/computer-use/scripts/check-plugin-resource-guards-self-test.py"
      ],
      "docs": [
        "docs/scripts/check-plugin-resource-guards.md"
      ]
    },
    {
      "name": "acceptance-evidence-manifest",
      "match": [
        "acceptance-evidence.json"
      ],
      "docs": [
        "docs/scripts/check-acceptance-evidence.md"
      ]
    },
    {
      "name": "acceptance-evidence",
      "match": [
        "platforms/linux/ubuntu/computer-use/scripts/check-acceptance-evidence.py",
        "platforms/linux/ubuntu/computer-use/scripts/check-acceptance-evidence-self-test.py"
      ],
      "docs": [
        "docs/scripts/check-acceptance-evidence.md"
      ],
      "onAdd": [
        "docs/scripts/README.md"
      ]
    },
    {
      "name": "bounded-command-self-test",
      "match": [
        "platforms/linux/ubuntu/computer-use/scripts/check-run-bounded-command-self-test.py"
      ],
      "docs": [
        "docs/scripts/run-bounded-command.md"
      ]
    },
    {
      "name": "repository-qa-self-test",
      "match": [
        "platforms/linux/ubuntu/computer-use/scripts/check-repository-qa-self-test.py"
      ],
      "docs": [
        "docs/scripts/check-repository-qa.md"
      ]
    },
    {
      "name": "skill-docs-self-test",
      "match": [
        "platforms/linux/ubuntu/computer-use/scripts/check-skill-docs-self-test.py"
      ],
      "docs": [
        "docs/scripts/check-skill-docs.md"
      ]
    },
    {
      "name": "doc-coverage-self-test",
      "match": [
        "platforms/linux/ubuntu/computer-use/scripts/check-doc-coverage-self-test.py"
      ],
      "docs": [
        "docs/scripts/check-doc-coverage.md"
      ]
    },
    {
      "name": "opencode-launcher",
      "match": [
        "platforms/linux/ubuntu/computer-use/scripts/opencode-launcher.sh",
        "platforms/linux/ubuntu/computer-use/scripts/opencode-launcher-self-test.py"
      ],
      "docs": [
        "docs/scripts/opencode-launcher.md"
      ],
      "onAdd": [
        "docs/scripts/README.md"
      ]
    },
    {
      "name": "setup-ponytail-plugin",
      "match": [
        "platforms/linux/ubuntu/computer-use/scripts/setup-ponytail-plugin.sh",
        "platforms/linux/ubuntu/computer-use/scripts/setup-ponytail-plugin-self-test.py"
      ],
      "docs": [
        "docs/scripts/setup-ponytail-plugin.md"
      ],
      "onAdd": [
        "docs/scripts/README.md"
      ]
    },
    {
      "name": "scripts",
      "match": [
        "platforms/linux/ubuntu/computer-use/scripts/*.sh",
        "platforms/linux/ubuntu/computer-use/scripts/*.py"
      ],
      "docs": [
        "docs/scripts/{stem}.md"
      ],
      "onAdd": [
        "docs/scripts/README.md"
      ]
    },
    {
      "name": "rig-tools-screen-terminal",
      "match": [
        "platforms/linux/ubuntu/computer-use/plugins-v2/rig-tools/scripts/screen-resize.py",
        "platforms/linux/ubuntu/computer-use/plugins-v2/rig-tools/src/screen-terminal.ts",
        "platforms/linux/ubuntu/computer-use/plugins-v2/rig-tools/src/tool-catalog.ts",
        "platforms/linux/ubuntu/computer-use/plugins-v2/rig-tools/test/screen-terminal.test.ts",
        "platforms/linux/ubuntu/computer-use/plugins-v2/rig-tools/test/tool-catalog.test.ts"
      ],
      "docs": [
        "platforms/linux/ubuntu/computer-use/plugins-v2/rig-tools/README.md",
        "docs/plugins/screen-terminal.md"
      ],
      "onAdd": [
        "docs/README.md",
        "docs/plugins/README.md"
      ]
    },
    {
      "name": "plugins-v2",
      "match": [
        "platforms/linux/ubuntu/computer-use/plugins-v2/**"
      ],
      "docs": [
        "platforms/linux/ubuntu/computer-use/plugins-v2/README.md"
      ],
      "onAdd": [
        "docs/plugins/README.md"
      ]
    },
    {
      "name": "skills",
      "match": [
        "platforms/linux/ubuntu/computer-use/skills/*/**"
      ],
      "docs": [
        "platforms/linux/ubuntu/computer-use/skills/{skill}/README.md",
        "platforms/linux/ubuntu/computer-use/skills/README.md"
      ]
    },
    {
      "name": "commands",
      "match": [
        "platforms/linux/ubuntu/computer-use/commands/*.md"
      ],
      "docs": [
        "docs/scripts/setup-opencode.md",
        "platforms/linux/ubuntu/computer-use/README.md"
      ]
    },
    {
      "name": "config-examples",
      "match": [
        "platforms/linux/ubuntu/computer-use/config/*"
      ],
      "docs": [
        "platforms/linux/ubuntu/computer-use/README.md"
      ]
    },
    {
      "name": "browser-manifests",
      "match": [
        "platforms/linux/ubuntu/browser-tools/package.json",
        "platforms/linux/ubuntu/browser-tools/package-lock.json"
      ],
      "docs": [
        "platforms/linux/ubuntu/computer-use/scripts/setup-computer-assistant.sh",
        "docs/scripts/setup-computer-assistant.md",
        "platforms/linux/ubuntu/computer-use/README.md"
      ]
    },
    {
      "name": "github-tools",
      "match": [
        "platforms/linux/ubuntu/github-tools/**"
      ],
      "docs": [
        "docs/scripts/github-mcp.md",
        "platforms/linux/ubuntu/github-tools/README.md"
      ]
    },
    {
      "name": "git-hooks",
      "match": [
        ".githooks/**"
      ],
      "docs": [
        "docs/scripts/setup-git-hooks.md"
      ]
    },
    {
      "name": "documentation-map",
      "match": [
        "documentation-map.json"
      ],
      "docs": [
        "AGENTS.md",
        "docs/scripts/check-doc-coverage.md"
      ]
    },
    {
      "name": "root-readme",
      "match": [
        "README.md"
      ],
      "docs": [
        "README.md"
      ]
    },
    {
      "name": "maintainer-features",
      "match": [
        "docs/maintainer-features.md"
      ],
      "docs": [
        "docs/maintainer-features.md"
      ]
    },
    {
      "name": "handoff-document",
      "match": [
        "HANDOFF.md"
      ],
      "docs": [
        "HANDOFF.md"
      ]
    },
    {
      "name": "roadmap-document",
      "match": [
        "ROADMAP.md"
      ],
      "docs": [
        "ROADMAP.md"
      ]
    }
  ],
  "additional": [
    {
      "name": "handoff",
      "match": [
        "documentation-map.json",
        ".githooks/**",
        ".github/**",
        "platforms/windows/wsl2/ubuntu/computer-use/**",
        "platforms/linux/ubuntu/computer-use/commands/*.md",
        "platforms/linux/ubuntu/computer-use/plugins-v2/README.md",
        "platforms/linux/ubuntu/computer-use/plugins-v2/*/README.md",
        "platforms/linux/ubuntu/computer-use/plugins-v2/*/package.json",
        "platforms/linux/ubuntu/computer-use/skills/README.md",
        "platforms/linux/ubuntu/computer-use/scripts/setup-computer-assistant.sh",
        "platforms/linux/ubuntu/computer-use/scripts/setup-opencode.sh",
        "platforms/linux/ubuntu/computer-use/scripts/basic-memory-mcp.sh",
        "platforms/linux/ubuntu/computer-use/scripts/setup-git-hooks.sh",
        "platforms/linux/ubuntu/computer-use/scripts/deploy-plugins.sh",
        "platforms/linux/ubuntu/computer-use/scripts/verify-opencode-v2.sh",
        "platforms/linux/ubuntu/computer-use/scripts/playwright-mcp.sh",
        "platforms/linux/ubuntu/computer-use/scripts/github-mcp.sh",
        "platforms/linux/ubuntu/browser-tools/package.json",
        "platforms/linux/ubuntu/browser-tools/package-lock.json",
        "platforms/linux/ubuntu/github-tools/README.md"
      ],
      "docs": [
        "HANDOFF.md"
      ]
    }
  ]
}
